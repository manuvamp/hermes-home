### ==================================================================
### Hermes Home — environment template
### Copy to .env and fill in only what you're connecting.
### Nothing here may be committed; .env is git-ignored.
### ==================================================================

# ---- Core MCP server ----
PORT=3000   # change if another app uses 3000
LOG_LEVEL=info

# Public URL Alexa+ will reach (e.g. your Cloudflare Tunnel hostname).
# Required for AUTH_MODE=oauth2 and for the OAuth discovery documents.
# PUBLIC_BASE_URL=https://hermes-home.your-tunnel.example.com

# ---- Auth ----
# 'local'  : loopback-only dev (DNS-rebind guard enforces localhost).
# 'oauth2' : internet-safe. Requires AUTH_JWKS_URI — real RS256 JWKS-verified bearer tokens.
AUTH_MODE=local

# Optional: even in local mode, demand a static bearer token.
# AUTH_LOCAL_TOKEN=dev-secret-token

# oauth2 production wiring (see docs/oauth-reference/README.md)
# AUTH_ISSUER=https://your-idp.example.com
# AUTH_AUDIENCE=hermes-home
# AUTH_JWKS_URI=https://your-idp.example.com/.well-known/jwks.json

# ---- Hermes runtime (NEVER exposed publicly) ----
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=change-me
# HERMES_MODEL=default
# HERMES_ASK_TIMEOUT_MS=20000
# Keep 'true' in the real demo. Set 'false' ONLY for unit tests — never for a judge walkthrough.
HERMES_REQUIRED=true
# SSH tunnel used by `npm run demo` to reach the Hermes VM API (127.0.0.1:8642)
# HERMES_VM=user@your-vm-ip
# HERMES_SSH_KEY=C:\Users\you\.ssh\id_ed25519

# ---- Home Assistant ----
# HASS_URL=http://homeassistant.local:8123
# HASS_TOKEN=eyJ…long-lived-access-token

# ---- Calendar (choose ONE path) ----
# Easiest: secret .ics subscription URL. iCloud: Calendar → share → public link.
# Google Calendar: Settings → calendar → "Secret address in iCal format".
# CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/…/basic.ics
#
# Or CalDAV (Nextcloud/Fastmail/iCloud app-specific password):
# CALDAV_URL=https://caldav.fastmail.com/dav/calendars/user/you@example.com/…/
# CALDAV_USERNAME=you@example.com
# CALDAV_PASSWORD=app-specific-password

# ---- GitHub (read-only triage) ----
# Classic PAT with 'repo' scope: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_…
# GITHUB_USER=your-github-username

# ---- Messaging notifications (any combination) ----
# Telegram — from @BotFather; get your chat_id from https://api.telegram.org/bot<token>/getUpdates
# TELEGRAM_BOT_TOKEN=123456:ABC-…
# TELEGRAM_CHAT_ID=123456789
# Discord — Server settings → Integrations → Webhooks
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/…
# Slack — https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/…

# ---- Storage / tuning ----
# HERMES_HOME_MEMORY_PATH=./data/memory.json
# MCP_SESSION_TTL_MS=1800000

# ---- Dashboard ----
# DASHBOARD_PORT=3100
# MCP_URL=http://127.0.0.1:3000

# ---- Hermes messaging gateway (send_message tool: DMs via Hermes' own bot) ----
# HERMES_SEND_SSH_HOST=<vm-ip>
# HERMES_SEND_SSH_USER=<ssh-user>
# HERMES_SEND_SSH_KEY=C:\Users\you\.ssh\id_ed25519
# HERMES_SEND_TARGET=discord:<your_discord_username>
